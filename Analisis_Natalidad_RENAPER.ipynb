    },
    {
      "cell_type": "code",
      "source": [
        "df_periodo_estudio = df[df['anio'] >= 2015].copy()\n"
      ],
      "metadata": {
        "id": "TY1f4M2CPKww"
      },
      "execution_count": 31,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "nacimientos_por_grupo = df.groupby(['anio', 'macro_edad_madre'])['cantidad'].sum().unstack()\n"
      ],
      "metadata": {
        "id": "qoad1Kk0P6M0"
      },
      "execution_count": 32,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "participacion_por_grupo = nacimientos_por_grupo.div(nacimientos_por_grupo.sum(axis=1), axis=0) * 100\n",
        "\n",
        "\n",
        "print(\"\\n--- Participación Porcentual (%) por Grupo Etario Materno ---\")\n",
        "print(participacion_por_grupo.round(2))\n"
      ],
