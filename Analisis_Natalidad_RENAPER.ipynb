   "source": [
    "# Comparación de la distribución de nacimientos por edad de la madre: 2012 vs. 2024\n",
    "\n",
    "\n",
    "# 1. Seleccionar los años que vamos a comparar\n",
    "df_comparacion = df[df[\"anio\"].isin([2012, 2024])].copy()\n",
    "\n",
    "# 2. Sumar los nacimientos por grupo etario para cada año\n",
    "nacimientos = (\n",
    "    df_comparacion\n",
    "    .groupby([\"grupo_etario_madre\", \"anio\"])[\"cantidad\"]\n",
    "    .sum()\n",
    "    .unstack(fill_value=0)\n",
    ")\n",
    "\n",
    "# 3. Comprobar que estén disponibles los dos años\n",
    "for anio in [2012, 2024]:\n",
    "    if anio not in nacimientos.columns:\n",
    "        nacimientos[anio] = 0\n",
    "\n",
    "nacimientos = nacimientos[[2012, 2024]]\n",
    "\n",
    "# 4. Calcular el total de nacimientos de cada año\n",
    "total_2012 = nacimientos[2012].sum()\n",
    "total_2024 = nacimientos[2024].sum()\n",
    "\n",
    "# 5. Calcular qué porcentaje representa cada grupo etario en cada año\n",
    "nacimientos[\"participacion_2012_pct\"] = (\n",
    "    nacimientos[2012] / total_2012 * 100\n",
    ")\n",
    "\n",
    "nacimientos[\"participacion_2024_pct\"] = (\n",
    "    nacimientos[2024] / total_2024 * 100\n",
    ")\n",
    "\n",
    "# 6. Calcular el cambio de participación en puntos porcentuales\n",
    "nacimientos[\"cambio_participacion_pp\"] = (\n",
    "    nacimientos[\"participacion_2024_pct\"]\n",
    "    - nacimientos[\"participacion_2012_pct\"]\n",
    ")\n",
    "\n",
    "# 7. Crear una tabla final para presentar los resultados\n",
    "tabla_comparacion = nacimientos[\n",
    "    [\n",
    "        2012,\n",
    "        2024,\n",
    "        \"participacion_2012_pct\",\n",
    "        \"participacion_2024_pct\",\n",
    "        \"cambio_participacion_pp\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "tabla_comparacion.columns = [\n",
    "    \"Nacimientos 2012\",\n",
    "    \"Nacimientos 2024\",\n",
    "    \"Participación 2012 (%)\",\n",
    "    \"Participación 2024 (%)\",\n",
    "    \"Cambio (puntos porcentuales)\",\n",
    "]\n",
    "\n",
    "# 8. Mostrar los resultados con dos decimales\n",
    "display(tabla_comparacion.round(2))"
   ]
