    "# Obtener los cambios porcentuales calculados anteriormente\n",
    "cambios = tabla_comparacion[\"Cambio (puntos porcentuales)\"]\n",
    "\n",
    "# Crear el gráfico\n",
    "plt.figure(figsize=(11, 6))\n",
    "\n",
    "barras = plt.bar(\n",
    "    cambios.index.astype(str),\n",
    "    cambios.values\n",
    ")\n",
    "\n",
    "# Línea horizontal que marca el cero\n",
    "plt.axhline(y=0, linewidth=1)\n",
    "\n",
    "# Títulos y etiquetas\n",
    "plt.title(\n",
    "    \"Cambio en la participación porcentual de los nacimientos\\n\"\n",
    "    \"por grupo etario de la madre (2012-2024)\"\n",
    ")\n",
    "plt.xlabel(\"Grupo etario de la madre (años)\")\n",
    "plt.ylabel(\"Cambio en puntos porcentuales\")\n",
    "\n",
    "# Mostrar el valor de cada barra\n",
    "for barra, valor in zip(barras, cambios.values):\n",
    "    desplazamiento = 0.12 if valor >= 0 else -0.25\n",
    "\n",
    "    plt.text(\n",
    "        barra.get_x() + barra.get_width() / 2,\n",
    "        valor + desplazamiento,\n",
    "        f\"{valor:+.2f}\",\n",
    "        ha=\"center\",\n",
    "        va=\"center\"\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
