      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# El archivo se encuentra dentro de tu Google Drive, por lo que debes usar la ruta completa:\n",
        "df = pd.read_csv(\"/content/drive/MyDrive/cantidad_de_nacimientos_edad_madre_por_anio_de_nacimiento_2012_2024 (1).csv\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#A partir de aquí traigo los datos limpiados y consolidados de la rama principal\n",
        "# Definimos el diccionario de mapeo para agrupar las edades de la madre\n",
        "mapeo_edades = {\n",
        "    '10-14': 'Menores de 20 años',\n",
        "    '15-19': 'Menores de 20 años',\n",
        "    '20-24': '20 a 34 años',\n",
        "    '25-29': '20 a 34 años',\n",
        "    '30-34': '20 a 34 años',\n",
        "    '35-39': '35 años y más',\n",
        "    '40-44': '35 años y más',\n",
        "    '45-49': '35 años y más',\n",
        "    '50 y más': '35 años y más',\n",
        "    'S/I': 'Sin Información'\n",
        "}\n",
        "\n",
        "df['macro_edad_madre'] = df['grupo_etario_madre'].map(mapeo_edades)"
      ],
      "metadata": {
        "id": "TIFpKX6TO9Ak"
      },
      "execution_count": 24,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [],
      "metadata": {
        "id": "1N8KBQNJ9T3G"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "nacimientos_por_anio = df.groupby('anio')['cantidad'].sum().reset_index()\n",
        "print(\"\\n--- Evolución del Total de Nacimientos en Argentina ---\")\n",
        "print(nacimientos_por_anio)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
